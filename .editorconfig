root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Google JavaScript Style Guide: 80 columns
[*.{cjs,cts,js,mjs,mts,ts}]
max_line_length = 80

# Google Shell Style Guide: 2 spaces, 80 columns
[*.{bash,bats,sh}]
indent_size = 2
max_line_length = 80

[*.md]
trim_trailing_whitespace = false
indent_size = unset

[{Makefile,*.mk}]
indent_style = tab
