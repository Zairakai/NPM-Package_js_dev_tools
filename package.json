{
  "name": "@zairakai/js-dev-tools",
  "version": "1.0.0",
  "description": "The unified and centralized development toolkit for JavaScript/TypeScript projects - ESLint, Prettier, Stylelint, Knip, Vitest, Git Hooks, and GitLab CI pipeline templates",
  "keywords": [
    "dev-tools",
    "toolkit",
    "unified",
    "centralized",
    "makefile",
    "git-hooks",
    "gitlab-ci",
    "eslint",
    "prettier",
    "stylelint",
    "vitest",
    "knip",
    "typescript"
  ],
  "homepage": "https://js-dev-tools-3fa149.gitlab.io",
  "bugs": {
    "url": "https://gitlab.com/zairakai/npm-packages/js-dev-tools/-/issues",
    "email": "contact-project+zairakai-npm-packages-js-dev-tools-80188322-issue-@incoming.gitlab.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/zairakai/npm-packages/js-dev-tools.git"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/zairakai"
    },
    {
      "type": "twitch",
      "url": "https://www.twitch.tv/zairakai"
    }
  ],
  "license": "MIT",
  "author": "Stanislas Poisson <stanislas.p@the-white-rabbits.fr> (https://the-white-rabbits.fr)",
  "contributors": [
    {
      "name": "Stanislas Poisson",
      "url": "https://gitlab.com/zairakai",
      "role": "Maintainer"
    }
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./prettier": "./config/prettier.config.js",
    "./eslint": "./config/eslint.config.js",
    "./stylelint": "./config/stylelint.config.js",
    "./vitest": "./config/vitest.config.js",
    "./knip": "./config/knip.config.js",
    "./tsconfig": "./config/tsconfig.base.json",
    "./config/*": "./config/*"
  },
  "main": "index.js",
  "files": [
    ".gitlab/",
    "config/",
    "scripts/",
    "stubs/",
    "tools/",
    "index.js",
    ".editorconfig",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "eslint": "bash ./scripts/eslint.sh",
    "eslint:fix": "bash ./scripts/eslint-fix.sh",
    "postinstall": "bash ./scripts/setup-project.sh --silent || true",
    "knip": "bash ./scripts/knip.sh",
    "markdownlint": "bash ./scripts/markdownlint.sh",
    "markdownlint:fix": "bash ./scripts/markdownlint-fix.sh",
    "normalize": "make package-normalize",
    "package:validate": "make package-validate",
    "prettier": "bash ./scripts/prettier.sh",
    "prettier:fix": "bash ./scripts/prettier-fix.sh",
    "quality": "make quality",
    "quality:fix": "make quality-fix",
    "setup": "bash ./scripts/setup-project.sh",
    "stylelint": "bash ./scripts/stylelint.sh",
    "stylelint:fix": "bash ./scripts/stylelint-fix.sh",
    "test": "make test-all"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "colord": "2.9.7",
    "fast-uri": "3.1.9",
    "js-yaml": {
      ".": "4.3.2"
    },
    "katex": "0.18.11",
    "markdown-it": "14.3.3",
    "minimatch": "11.0.6",
    "nanoid": "3.3.20",
    "re2js": "2.9.1",
    "smol-toml": "1.9.0"
  },
  "dependencies": {
    "@stanislas-poisson/js-dev-tools": "^2.0.0",
    "eslint": "^10.14.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.6",
    "stylelint": "^17.16.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "knip": "^6.44.2",
    "sort-package-json": "^4.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "eslint": "^10.14.0",
    "typedoc": "^0.28.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    },
    "typedoc": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
